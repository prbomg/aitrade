# ============================================================================
# AItrade — Конфигурация ключей API (Bybit V5 Demo Trading, Coinalyze, LLM)
# Скопируйте этот файл в .env и укажите ваши ключи
# ============================================================================

# 1. Ключи Bybit Unified Demo Trading (https://api-demo.bybit.com)
# Создаются в личном кабинете Bybit -> Переключиться на "Демо-трейдинг" -> API Management
BYBIT_DEMO_API_KEY=
BYBIT_DEMO_API_SECRET=

# Ключи Bybit Mainnet (используются ТОЛЬКО если переключить mode=live)
BYBIT_LIVE_API_KEY=
BYBIT_LIVE_API_SECRET=

# Режим работы биржевого коннектора: demo | paper | live
AITRADE_MODE=demo

# 2. Опционально: Coinalyze API (бесплатный лимит 40 запросов/мин для кросс-биржевого OI/CVD)
COINALYZE_API_KEY=

# 3. Опционально: Ключ LLM для расширенных дебатов агентов (OpenAI / Gemini / DeepSeek)
# Если не указан, работает встроенный детерминированный Multi-Agent Debate Engine
OPENAI_API_KEY=
GEMINI_API_KEY=
LLM_MODEL=gpt-4o-mini

# 4. Опционально: Telegram-бот для мгновенной отправки карточек снайперских сигналов
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 5. Авторизация на веб-сервере KAIROS (если заданы — включается страница входа /login)
KAIROS_AUTH_USER=
KAIROS_AUTH_PASSWORD=
KAIROS_AUTH_SECRET=

