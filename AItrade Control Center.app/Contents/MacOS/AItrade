#!/bin/bash
export PATH="/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
APP_DIR="/Users/sergejrubcov/AItrade"
mkdir -p "$APP_DIR/data"
cd "$APP_DIR" || exit 1

if curl -sS -m 1 "http://127.0.0.1:8765/api/state" >/dev/null 2>&1; then
    /usr/bin/open "http://127.0.0.1:8765"
    exit 0
fi

nohup /usr/bin/python3 "$APP_DIR/gui_app.py" >> "$APP_DIR/data/app_launch.log" 2>&1 &
sleep 0.6
/usr/bin/open "http://127.0.0.1:8765"
exit 0
