{
  "$schema": "https://schema.freqtrade.io/schema.json",
  "trading_mode": "futures",
  "margin_mode": "isolated",
  "max_open_trades": 3,
  "stake_currency": "USDT",
  "stake_amount": "unlimited",
  "tradable_balance_ratio": 0.95,
  "fiat_display_currency": "USD",
  "dry_run": true,
  "dry_run_wallet": 10000,
  "cancel_open_orders_on_exit": true,
  "timeframe": "15m",
  "reduce_df_footprint": true,
  "exchange": {
    "name": "bybit",
    "key": "",
    "secret": "",
    "ccxt_config": {
      "enableRateLimit": true,
      "options": {
        "defaultType": "swap"
      },
      "urls": {
        "api": {
          "public": "https://api-demo.bybit.com",
          "private": "https://api-demo.bybit.com"
        }
      }
    },
    "pair_whitelist": [
      "BTC/USDT:USDT",
      "ETH/USDT:USDT",
      "SOL/USDT:USDT",
      "BNB/USDT:USDT",
      "XRP/USDT:USDT",
      "ADA/USDT:USDT",
      "DOGE/USDT:USDT",
      "AVAX/USDT:USDT",
      "LINK/USDT:USDT",
      "SUI/USDT:USDT"
    ],
    "pair_blacklist": []
  },
  "pairlists": [
    {"method": "StaticPairList"}
  ],
  "freqai": {
    "enabled": true,
    "purge_old_models": 2,
    "train_period_days": 30,
    "backtest_period_days": 7,
    "live_retrain_hours": 4,
    "expiration_hours": 12,
    "identifier": "bybit_intraday_sniper_v1",
    "feature_parameters": {
      "include_timeframes": ["15m", "1h", "4h"],
      "include_corr_pairlist": ["BTC/USDT:USDT", "ETH/USDT:USDT"],
      "label_period_candles": 8,
      "include_shifted_candles": 3,
      "DI_threshold": 1.0,
      "weight_factor": 0.85,
      "principal_component_analysis": false,
      "use_SVM_to_remove_outliers": true,
      "use_DBSCAN_to_remove_outliers": false,
      "outlier_protection_percentage": 30,
      "indicator_periods_candles": [14, 20, 50]
    },
    "data_split_parameters": {
      "test_size": 0.25,
      "shuffle": false
    },
    "model_training_parameters": {
      "n_estimators": 400,
      "learning_rate": 0.03,
      "max_depth": 6
    }
  },
  "bot_name": "AItrade_Bybit_Combine"
}
